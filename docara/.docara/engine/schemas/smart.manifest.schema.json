{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://simai.io/sf5/schemas/smart.manifest.schema.json",
  "title": "SF5 Smart Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "code", "title", "render"],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "kind": {
      "type": "string",
      "const": "smart"
    },
    "code": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "family": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]*$"
    },
    "category": {
      "type": "string"
    },
    "render": {
      "$ref": "#/$defs/render"
    },
    "props": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/prop"
      }
    },
    "slots": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/slot"
      }
    },
    "events": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/event"
      }
    },
    "regions": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/slot"
      }
    },
    "children": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/child"
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "assets": {
      "$ref": "#/$defs/assets"
    },
    "cache": {
      "$ref": "#/$defs/cache"
    },
    "ai": {
      "$ref": "#/$defs/ai"
    },
    "meta": {
      "type": "object",
      "additionalProperties": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["server-first", "client-only", "hybrid"]
        },
        "strategy": {
          "type": "string",
          "enum": ["server-static", "server-first-hydratable", "client-owned", "shadow-dom-owned"]
        },
        "template": {
          "type": "string"
        },
        "hydration": {
          "type": "string",
          "enum": ["none", "optional", "required"]
        },
        "domStrategy": {
          "type": "string",
          "enum": ["none", "light-dom-adopt", "host-attributes", "shadow-dom"]
        },
        "updateStrategy": {
          "type": "string",
          "enum": ["none", "patch", "rerender"]
        },
        "initialHtml": {
          "type": "string",
          "enum": ["complete", "skeleton", "host-only"]
        },
        "frontendOwnership": {
          "type": "string",
          "enum": ["none", "behavior", "dom"]
        }
      }
    },
    "prop": {
      "type": "object",
      "additionalProperties": true,
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["string", "number", "boolean", "enum", "object", "array", "content", "asset", "link"]
        },
        "default": {},
        "values": {
          "type": "array",
          "items": {
            "type": ["string", "number", "boolean"]
          }
        },
        "required": {
          "type": "boolean"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "accepts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "required": {
          "type": "boolean"
        },
        "multiple": {
          "type": "boolean"
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "frontend": {
          "type": "boolean"
        },
        "backend": {
          "type": "boolean"
        },
        "payload": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "child": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "smart"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "smart": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]*$"
        },
        "view": {
          "type": "string"
        },
        "preset": {
          "type": "string"
        },
        "props": {
          "type": "object",
          "additionalProperties": true
        },
        "slot": {
          "type": "string"
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "css": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "js": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "depends": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "cache": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fragment": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "varyBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "useWhen": {
          "type": "string"
        },
        "avoidWhen": {
          "type": "string"
        },
        "composeWith": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
