{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://schemas.simai.io/docara/framework-lock/v1",
    "title": "Docara wrapper for a pinned SIMAI Framework runtime",
    "type": "object",
    "required": ["schema", "runtime", "manifests", "asset_projection", "nonclaims"],
    "properties": {
        "schema": {
            "type": "string",
            "const": "docara.framework_lock.v1"
        },
        "version": {
            "type": "integer",
            "const": 1
        },
        "runtime": {
            "type": "object",
            "required": [
                "schema",
                "runtime",
                "pair_id",
                "bundle_id",
                "publication_profile",
                "tag",
                "ui",
                "ui_smart",
                "framework_registry",
                "boot",
                "components"
            ],
            "properties": {
                "schema": {
                    "type": "string",
                    "const": "larena.ui.frontend_runtime_lock.v3"
                },
                "runtime": {
                    "type": "string",
                    "const": "simai-framework"
                },
                "pair_id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]+$"
                },
                "bundle_id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]+$"
                },
                "publication_profile": {
                    "type": "string",
                    "enum": [
                        "verified-release-artifact-v1",
                        "verified-commit-candidate-v1"
                    ]
                },
                "tag": {
                    "type": ["string", "null"],
                    "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
                },
                "ui": {
                    "$ref": "#/$defs/ui_source"
                },
                "ui_smart": {
                    "$ref": "#/$defs/ui_smart_source"
                },
                "framework_registry": {
                    "$ref": "#/$defs/framework_registry"
                },
                "boot": {
                    "$ref": "#/$defs/boot"
                },
                "shell": {
                    "$ref": "#/$defs/runtime_shell"
                },
                "components": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                        "$ref": "#/$defs/runtime_component"
                    }
                }
            },
            "additionalProperties": false
        },
        "manifests": {
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
                "pattern": "^ui(?:\\.[a-z][a-z0-9_]*)+$"
            },
            "additionalProperties": {
                "$ref": "#/$defs/manifest"
            }
        },
        "asset_projection": {
            "type": "object",
            "required": ["schema", "mount", "source", "files"],
            "properties": {
                "schema": {
                    "type": "string",
                    "const": "docara.framework_asset_projection.v1"
                },
                "mount": {
                    "type": "string",
                    "enum": ["_docara/framework", "_docara/framework-runtime"]
                },
                "source": {
                    "type": "object",
                    "required": ["provider", "revision"],
                    "properties": {
                        "provider": {
                            "type": "string",
                            "enum": ["simai/ui-smart", "simai/ui"]
                        },
                        "revision": {
                            "type": "string",
                            "format": "docara-immutable-revision"
                        }
                    },
                    "additionalProperties": false
                },
                "files": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                        "$ref": "#/$defs/projected_asset"
                    }
                }
            },
            "additionalProperties": false
        },
        "dynamic_asset_projection": {
            "type": "object",
            "required": ["schema", "mount", "source", "files"],
            "properties": {
                "schema": {
                    "type": "string",
                    "const": "docara.framework_dynamic_asset_projection.v1"
                },
                "mount": {
                    "type": "string",
                    "const": "_docara/framework-runtime"
                },
                "source": {
                    "type": "object",
                    "required": ["provider", "revision"],
                    "properties": {
                        "provider": {
                            "type": "string",
                            "enum": ["simai/ui-smart", "simai/ui"]
                        },
                        "revision": {
                            "type": "string",
                            "format": "docara-immutable-revision"
                        }
                    },
                    "additionalProperties": false
                },
                "files": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                        "$ref": "#/$defs/projected_asset"
                    }
                }
            },
            "additionalProperties": false
        },
        "typography_projection": {
            "$ref": "#/$defs/typography_projection"
        },
        "runtime_projection": {
            "$ref": "#/$defs/runtime_projection"
        },
        "icon_projection": {
            "$ref": "#/$defs/icon_projection"
        },
        "package_projections": {
            "description": "Product component packages served beside the Framework under their own mount, each taken by its package receipt; keyed by package name.",
            "type": "object",
            "minProperties": 1,
            "propertyNames": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
            },
            "additionalProperties": {
                "$ref": "#/$defs/package_projection"
            }
        },
        "nonclaims": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
                "type": "string",
                "minLength": 1
            }
        }
    },
    "additionalProperties": false,
    "$defs": {
        "package_projection": {
            "description": "A product component package taken by its package receipt (simai.framework.product-package-receipt version 1).",
            "type": "object",
            "required": [
                "schema",
                "schema_version",
                "package",
                "requires",
                "mount",
                "receipt",
                "files"
            ],
            "properties": {
                "schema": {
                    "type": "string",
                    "const": "docara.framework_package_projection"
                },
                "schema_version": {
                    "type": "integer",
                    "const": 2
                },
                "package": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                },
                "requires": {
                    "description": "The free release the package was built against (the receipt's framework.release); equals runtime.pair_id.",
                    "type": "string",
                    "pattern": "^ui-[a-f0-9]{12}$"
                },
                "mount": {
                    "description": "_docara/framework-packages/<package>/<package source revision>.",
                    "type": "string",
                    "pattern": "^_docara/framework-packages/[a-z][a-z0-9-]*/[a-f0-9]{40}$"
                },
                "receipt": {
                    "type": "object",
                    "required": [
                        "schema",
                        "schema_version",
                        "package_source",
                        "framework_source",
                        "builder",
                        "manifest_sha256",
                        "archive_sha256"
                    ],
                    "properties": {
                        "schema": {
                            "type": "string",
                            "const": "simai.framework.product-package-receipt"
                        },
                        "schema_version": {
                            "type": "integer",
                            "const": 1
                        },
                        "package_source": {
                            "type": "object",
                            "required": [
                                "repository",
                                "revision",
                                "path",
                                "tree"
                            ],
                            "properties": {
                                "repository": {
                                    "type": "string",
                                    "pattern": "^[a-z0-9-]+/[a-z0-9._-]+$"
                                },
                                "revision": {
                                    "type": "string",
                                    "format": "docara-immutable-revision"
                                },
                                "path": {
                                    "type": "string"
                                },
                                "tree": {
                                    "type": "string",
                                    "pattern": "^[a-f0-9]{40}$"
                                }
                            },
                            "additionalProperties": false
                        },
                        "framework_source": {
                            "type": "object",
                            "required": [
                                "repository",
                                "revision"
                            ],
                            "properties": {
                                "repository": {
                                    "type": "string",
                                    "pattern": "^[a-z0-9-]+/[a-z0-9._-]+$"
                                },
                                "revision": {
                                    "type": "string",
                                    "format": "docara-immutable-revision"
                                }
                            },
                            "additionalProperties": false
                        },
                        "builder": {
                            "type": "object",
                            "required": [
                                "repository",
                                "revision"
                            ],
                            "properties": {
                                "repository": {
                                    "type": "string",
                                    "pattern": "^[a-z0-9-]+/[a-z0-9._-]+$"
                                },
                                "revision": {
                                    "type": "string",
                                    "pattern": "^[a-f0-9]{40}$"
                                }
                            },
                            "additionalProperties": false
                        },
                        "manifest_sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                        },
                        "archive_sha256": {
                            "type": "string",
                            "pattern": "^[a-f0-9]{64}$"
                        }
                    },
                    "additionalProperties": false
                },
                "files": {
                    "type": "object",
                    "minProperties": 1,
                    "additionalProperties": {
                        "$ref": "#/$defs/projected_asset"
                    }
                }
            },
            "additionalProperties": false
        },
        "icon_projection": {
            "type": "object",
            "required": ["schema", "source", "packet_sha256", "files"],
            "properties": {
                "schema": {"type": "string", "const": "docara.framework_icon_projection.v1"},
                "source": {
                    "type": "object",
                    "required": ["provider", "revision", "license"],
                    "properties": {
                        "provider": {"type": "string", "const": "google/material-design-icons"},
                        "revision": {"type": "string", "format": "docara-immutable-revision"},
                        "license": {"type": "string", "const": "Apache-2.0"}
                    },
                    "additionalProperties": false
                },
                "packet_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "files": {
                    "type": "object",
                    "required": ["license", "outlined", "rounded", "sharp"],
                    "properties": {
                        "license": {"$ref": "#/$defs/typography_asset"},
                        "outlined": {"$ref": "#/$defs/typography_asset"},
                        "rounded": {"$ref": "#/$defs/typography_asset"},
                        "sharp": {"$ref": "#/$defs/typography_asset"}
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "runtime_projection": {
            "type": "object",
            "required": ["schema", "mount", "source", "icon_font", "packet_sha256", "files", "manifest"],
            "properties": {
                "schema": {"type": "string", "const": "docara.framework_runtime_projection.v1"},
                "mount": {"type": "string", "format": "docara-relative-path"},
                "source": {
                    "type": "object",
                    "required": ["provider", "revision", "tree_sha256"],
                    "properties": {
                        "provider": {"type": "string", "const": "simai/ui"},
                        "revision": {"type": "string", "format": "docara-immutable-revision"},
                        "tree_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
                    },
                    "additionalProperties": false
                },
                "icon_font": {"type": "string", "format": "docara-relative-path"},
                "packet_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "files": {"type": "integer", "minimum": 1},
                "manifest": {"$ref": "#/$defs/typography_asset"}
            },
            "additionalProperties": false
        },
        "typography_projection": {
            "type": "object",
            "required": ["schema", "candidate", "source", "builder", "distribution", "packet_sha256", "files"],
            "properties": {
                "schema": {"type": "string", "const": "docara.framework_typography_projection.v1"},
                "candidate": {
                    "type": "string",
                    "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-rc\\.[0-9]+)?$"
                },
                "source": {"$ref": "#/$defs/typography_source"},
                "builder": {"$ref": "#/$defs/typography_builder"},
                "distribution": {"$ref": "#/$defs/typography_distribution"},
                "packet_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
                "files": {
                    "type": "object",
                    "required": ["contract", "core", "utility"],
                    "properties": {
                        "contract": {"$ref": "#/$defs/typography_asset"},
                        "core": {"$ref": "#/$defs/typography_asset"},
                        "utility": {"$ref": "#/$defs/typography_asset"}
                    },
                    "patternProperties": {
                        "^font_[a-f0-9]{20}$": {"$ref": "#/$defs/typography_asset"}
                    },
                    "additionalProperties": false
                }
            },
            "additionalProperties": false
        },
        "typography_source": {
            "type": "object",
            "required": ["provider", "revision", "rollback_parent"],
            "properties": {
                "provider": {"type": "string", "enum": ["simai/ui-source", "simai/ui-loader"]},
                "revision": {"type": "string", "format": "docara-immutable-revision"},
                "rollback_parent": {"type": "string", "format": "docara-immutable-revision"}
            },
            "additionalProperties": false
        },
        "typography_builder": {
            "type": "object",
            "required": ["provider", "revision"],
            "properties": {
                "provider": {"type": "string", "const": "simai/ui-builder"},
                "revision": {"type": "string", "format": "docara-immutable-revision"}
            },
            "additionalProperties": false
        },
        "typography_distribution": {
            "type": "object",
            "required": ["provider", "revision", "rollback_parent", "published"],
            "properties": {
                "provider": {"type": "string", "const": "simai/ui"},
                "revision": {"type": "string", "format": "docara-immutable-revision"},
                "rollback_parent": {"type": "string", "format": "docara-immutable-revision"},
                "published": {"type": "boolean"}
            },
            "additionalProperties": false
        },
        "typography_asset": {
            "type": "object",
            "required": ["path", "public", "sha256"],
            "properties": {
                "path": {"type": "string", "format": "docara-relative-path"},
                "public": {"type": "string", "format": "docara-relative-path"},
                "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
            },
            "additionalProperties": false
        },
        "projected_asset": {
            "type": "object",
            "required": ["sha256"],
            "properties": {
                "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                }
            },
            "additionalProperties": false
        },
        "publication_source": {
            "type": "object",
            "required": ["tag", "commit", "tree", "mount", "sha256", "files"],
            "properties": {
                "tag": {
                    "type": ["string", "null"],
                    "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
                },
                "commit": {
                    "type": "string",
                    "format": "docara-immutable-revision"
                },
                "tree": {
                    "type": "string",
                    "format": "docara-relative-path"
                },
                "mount": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]*$"
                },
                "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                },
                "files": {
                    "type": "integer",
                    "minimum": 1
                }
            },
            "additionalProperties": false
        },
        "ui_source": {
            "type": "object",
            "required": ["tag", "commit", "tree", "mount", "sha256", "files"],
            "properties": {
                "tag": {
                    "type": ["string", "null"],
                    "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
                },
                "commit": {
                    "type": "string",
                    "format": "docara-immutable-revision"
                },
                "tree": {
                    "type": "string",
                    "const": "distr"
                },
                "mount": {
                    "type": "string",
                    "const": "ui"
                },
                "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                },
                "files": {
                    "type": "integer",
                    "minimum": 1
                }
            },
            "additionalProperties": false
        },
        "ui_smart_source": {
            "type": "object",
            "required": ["tag", "commit", "tree", "mount", "sha256", "files"],
            "properties": {
                "tag": {
                    "type": ["string", "null"],
                    "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"
                },
                "commit": {
                    "type": "string",
                    "format": "docara-immutable-revision"
                },
                "tree": {
                    "description": "smart: the separate simai/ui-smart repository (release lock v1); distr/smart: the ui release itself, same commit as ui (release lock v2).",
                    "type": "string",
                    "enum": ["smart", "distr/smart"]
                },
                "mount": {
                    "type": "string",
                    "enum": ["smart", "ui"]
                },
                "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                },
                "files": {
                    "type": "integer",
                    "minimum": 1
                }
            },
            "additionalProperties": false
        },
        "framework_registry": {
            "type": "object",
            "required": ["schema_id", "compatibility_id", "profile", "relative_path", "file_sha256", "source"],
            "properties": {
                "schema_id": {
                    "type": "string",
                    "const": "simai.framework.contract-registry"
                },
                "compatibility_id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._-]+$"
                },
                "profile": {
                    "type": "string",
                    "const": "plain-assets-v1"
                },
                "relative_path": {
                    "type": "string",
                    "format": "docara-relative-path"
                },
                "file_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                },
                "source": {
                    "$ref": "#/$defs/framework_registry_source"
                },
                "documentation_source": {
                    "$ref": "#/$defs/framework_documentation_source"
                }
            },
            "additionalProperties": false
        },
        "framework_documentation_source": {
            "type": "object",
            "required": ["schema", "relative_path", "file_sha256"],
            "properties": {
                "schema": {
                    "type": "string",
                    "const": "docara.documentation_source.v1"
                },
                "relative_path": {
                    "type": "string",
                    "format": "docara-relative-path"
                },
                "file_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                }
            },
            "additionalProperties": false
        },
        "framework_registry_source": {
            "type": "object",
            "required": ["commit", "tree", "tree_oid", "mount", "sha256", "files"],
            "properties": {
                "commit": {
                    "type": "string",
                    "format": "docara-immutable-revision"
                },
                "tree": {
                    "type": "string",
                    "const": "contracts/generated"
                },
                "tree_oid": {
                    "type": "string",
                    "format": "docara-immutable-revision"
                },
                "mount": {
                    "type": "string",
                    "const": "contract"
                },
                "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                },
                "files": {
                    "type": "integer",
                    "minimum": 1
                }
            },
            "additionalProperties": false
        },
        "boot": {
            "type": "object",
            "required": ["css", "javascript", "smart_base", "ui_base", "smart_base_path"],
            "properties": {
                "css": {
                    "type": "string",
                    "format": "docara-relative-path"
                },
                "javascript": {
                    "type": "string",
                    "format": "docara-relative-path"
                },
                "smart_base": {
                    "type": "string",
                    "format": "docara-relative-path"
                },
                "ui_base": {
                    "type": "string",
                    "format": "docara-relative-directory"
                },
                "smart_base_path": {
                    "type": "string",
                    "format": "docara-relative-directory"
                }
            },
            "additionalProperties": false
        },
        "runtime_component": {
            "type": "object",
            "required": ["source", "javascript", "css", "attributes"],
            "properties": {
                "source": {
                    "type": "string",
                    "format": "docara-relative-path"
                },
                "javascript": {
                    "type": "string",
                    "format": "docara-relative-path"
                },
                "css": {
                    "type": ["string", "null"],
                    "format": "docara-relative-path"
                },
                "core_css": {
                    "type": ["string", "null"],
                    "format": "docara-relative-path"
                },
                "requires": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                },
                "loader": {
                    "$ref": "#/$defs/runtime_component_loader"
                },
                "attributes": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                        "type": "string",
                        "minLength": 1
                    }
                }
            },
            "additionalProperties": false
        },
        "runtime_component_loader": {
            "type": "object",
            "required": ["plugin", "relations"],
            "properties": {
                "plugin": {
                    "type": "string",
                    "pattern": "^cl-[a-z][a-z0-9-]*$"
                },
                "relations": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/runtime_component_relation"
                    }
                }
            },
            "additionalProperties": false
        },
        "runtime_shell": {
            "type": "object",
            "required": ["relations"],
            "properties": {
                "relations": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                        "$ref": "#/$defs/runtime_component_relation"
                    }
                }
            },
            "additionalProperties": false
        },
        "runtime_component_relation": {
            "type": "object",
            "required": ["plugin", "type", "css", "javascript"],
            "properties": {
                "plugin": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9-]*$"
                },
                "type": {
                    "type": "string",
                    "const": "component"
                },
                "css": {
                    "type": "string",
                    "format": "docara-relative-path"
                },
                "javascript": {
                    "type": "string",
                    "format": "docara-relative-path"
                }
            },
            "additionalProperties": false
        },
        "manifest": {
            "type": "object",
            "required": ["provider", "provider_revision", "sha256", "consumer_policy"],
            "properties": {
                "provider": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9._/-]*$"
                },
                "provider_revision": {
                    "type": "string",
                    "format": "docara-immutable-revision"
                },
                "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                },
                "consumer_policy": {
                    "$ref": "#/$defs/consumer_policy"
                }
            },
            "additionalProperties": false
        },
        "consumer_policy": {
            "type": "object",
            "required": ["managed", "blocked", "omitted_assets", "excluded_states"],
            "properties": {
                "managed": {
                    "type": "object",
                    "additionalProperties": {"type": "string", "const": "deterministic_id"}
                },
                "blocked": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "required": ["prop", "value", "code"],
                        "properties": {
                            "prop": {"type": "string", "minLength": 1},
                            "value": {},
                            "code": {"type": "string", "minLength": 1}
                        },
                        "additionalProperties": false
                    }
                },
                "omitted_assets": {
                    "type": "object",
                    "additionalProperties": {"type": "string", "minLength": 1}
                },
                "excluded_states": {
                    "type": "object",
