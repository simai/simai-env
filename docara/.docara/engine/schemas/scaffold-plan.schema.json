{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docara.local/schemas/scaffold-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plan_id", "kind", "id", "namespace", "input_hashes", "files"],
  "properties": {
    "schema": {"const": "docara.scaffold_plan.v1"},
    "plan_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "kind": {"enum": ["smart", "design", "page"]},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_./-]*$"},
    "namespace": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*$"},
    "options": {
      "type": "object",
      "additionalProperties": false,
      "required": ["locale", "title", "profile", "source", "entity"],
      "properties": {
        "locale": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "profile": {"enum": ["landing", "article", "tutorial", "how_to", "reference", "explanation"]},
        "source": {"type": ["string", "null"], "pattern": "^[a-z][a-z0-9-]*$"},
        "entity": {"type": ["string", "null"], "minLength": 1}
      }
    },
    "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "input_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^(?:absent|[a-f0-9]{64})$"}},
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "content_base64"],
        "properties": {
          "path": {"type": "string", "pattern": "^(?:smart|design|content|examples)/[a-zA-Z0-9._/-]+$"},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "content_base64": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
