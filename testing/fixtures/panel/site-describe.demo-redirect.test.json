{
  "domain": "demo-redirect.test",
  "profile": "redirect",
  "php": "none",
  "root": "/home/simai/www/demo-redirect.test",
  "public_dir": "public",
  "ssl": "none",
  "frame_policy": "same-origin",
  "runs_as": "site-demo-redirect-test",
  "owner": null,
  "database": null,
  "layout": "in-place",
  "release": null,
  "workers": [],
  "service": null,
  "scheduler": false,
  "backup_schedule": false,
  "adopted": null,
  "manifest": null,
  "logs": {
    "nginx_error": "/var/log/nginx/demo-redirect-test.error.log",
    "php_fpm": "/var/log/phpnone-fpm-demo-redirect-test.log",
    "app": "/home/simai/www/demo-redirect.test/storage/logs",
    "workers": []
  },
  "how_to": {
    "inspect": "simai-admin.sh site doctor --domain demo-redirect.test",
    "deploy": "simai-admin.sh site deploy --domain demo-redirect.test --git <url> --ref <tag> --confirm yes",
    "deploy_archive": "simai-admin.sh site deploy --domain demo-redirect.test --archive <file.tar.gz> --sha256 <sum> --confirm yes",
    "rollback": "simai-admin.sh site deploy-rollback --domain demo-redirect.test --confirm yes",
    "reconcile_requirements": "simai-admin.sh site adopt --domain demo-redirect.test --confirm yes",
    "backup": "simai-admin.sh backup data --domain demo-redirect.test --confirm yes",
    "verify_backup": "simai-admin.sh backup data-verify --path <backup-dir> --restore-test yes --confirm yes",
    "run_artisan_as_site_user": "sudo -u site-demo-redirect-test -H phpnone /home/simai/www/demo-redirect.test/artisan <command>"
  },
  "rules": [
    "Commands that change state print a plan unless --confirm yes is given; read the plan first.",
    "Do not edit nginx, PHP-FPM, cron or systemd files by hand; use simai-admin.sh so metadata stays consistent.",
    "Application secrets live in the site .env and /etc/simai-env/sites/<domain>/db.env; never print them."
  ],
  "schema": "simai-site/1"
}
